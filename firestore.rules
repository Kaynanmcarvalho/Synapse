rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function belongsToTenant(tenantId) {
      return authenticated()
        && request.auth.token.tenantId is string
        && request.auth.token.tenantId == tenantId;
    }

    match /tenants/{tenantId}/{document=**} {
      allow read: if belongsToTenant(tenantId);
      // Escritas críticas passam pela API/Admin SDK.
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/auditLogs/{logId} {
      allow read: if belongsToTenant(tenantId);
      allow create, update, delete: if false; // somente Admin SDK; append-only
    }

    match /platform/{document=**} {
      allow read, write: if false;
    }

    // Estado global do SaaS e segredos fiscais são exclusivos da API/Admin SDK.
    // Mantê-los fora de /tenants evita que a regra de leitura do tenant exponha
    // metadados comerciais ou até mesmo ciphertext aos clientes web/mobile.
    match /saasSubscriptions/{document=**} {
      allow read, write: if false;
    }

    match /tenantExperiences/{document=**} {
      allow read, write: if false;
    }

    match /serverSecrets/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
