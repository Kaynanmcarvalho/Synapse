{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "description": "ERP SaaS multi-tenant para distribuidoras de racao, agro e pet",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "backup:gcp": "node scripts/backup-gcp.mjs",
    "restore:gcp": "node scripts/restore-gcp.mjs",
    "restore:gcp:dry-run": "node scripts/restore-gcp.mjs --dry-run",
    "rollback:gcp": "node scripts/rollback-cloud-run.mjs",
    "rollback:gcp:dry-run": "node scripts/rollback-cloud-run.mjs --dry-run",
    "performance:seed": "node scripts/seed-performance.mjs",
    "performance:seed:dry-run": "node scripts/seed-performance.mjs --dry-run",
    "performance:load": "k6 run performance/k6/api-load.js",
    "performance:indexes:verify": "firebase emulators:exec --only firestore --project demo-synapse \"node scripts/verify-firestore-indexes.mjs\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "firebase-admin": "13.0.2",
    "firebase-tools": "15.29.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
