{
  "extends": "@synapse/config/tsconfig/library.cjs.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/cjs",
    "rootDir": "src",
    "tsBuildInfoFile": "./node_modules/.tmp/build.cjs.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.spec.tsx"]
}
