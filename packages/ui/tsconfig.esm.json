{
  "extends": "@synapse/config/tsconfig/library.esm.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "outDir": "dist/esm",
    "rootDir": "src",
    "tsBuildInfoFile": "./node_modules/.tmp/build.esm.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.spec.tsx"]
}
