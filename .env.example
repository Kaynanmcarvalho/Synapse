# ── Muvta (quadro de tarefas / MCP) ───────────────────────────────
MUVTA_API_URL=https://muvtaapi-production.up.railway.app
MUVTA_API_KEY=

# ── API ───────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3333
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Firebase Admin (apps/api e scripts) ───────────────────────────
FIREBASE_PROJECT_ID=
# Recomendado: caminho do JSON da conta de servico (Console do Firebase >
# Configuracoes do projeto > Contas de servico > Gerar nova chave privada).
# Guarde o arquivo FORA do repositorio e de pastas sincronizadas (OneDrive,
# Google Drive); aqui vai so o caminho, com barras normais:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/voce/.synapse/synapse-admin.json
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativa para servidor que injeta segredo por variavel (Secret Manager).
# Preenchidas, valem antes do arquivo acima.
FIREBASE_CLIENT_EMAIL=
# Em uma linha so, entre aspas e com as quebras escapadas como \n:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# O web-erp ainda nao envia token de App Check: em desenvolvimento contra o
# projeto real, use false. Com NODE_ENV=production a API ignora e sempre exige.
APP_CHECK_ENFORCEMENT=
SOURCE_STORAGE_BUCKET=
BACKUP_BUCKET=
TARGET_STORAGE_BUCKET=

# ── Cofre de segredos bancarios (§62) ─────────────────────────────
# 32 bytes em base64. Separada da chave fiscal de proposito.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BANKING_MASTER_KEY=

# ── Firebase Web (apps/web-*) ─────────────────────────────────────
# Vao no .env.local de cada app (apps/web-erp/.env.local), nao no da raiz.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_VAPID_KEY=
VITE_API_URL=http://localhost:3333/api/v1
EMAIL_API_URL=
EMAIL_API_KEY=
REDIS_URL=

# Massa e carga somente no emulador ou staging
PERF_TARGET=emulator
PERF_TENANT_ID=performance-tenant
# Chave AES-256 (32 bytes em base64) para certificado A1, senha e CSC.
FISCAL_MASTER_KEY=
